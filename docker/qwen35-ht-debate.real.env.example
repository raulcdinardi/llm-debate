# Real-but-still-4070-aware HT debate run.
# Copy to docker/qwen35-ht-debate.env for local docker compose, or map these
# values into Vast env vars.

MODEL_ID=Qwen/Qwen3.5-4B-Base
REQUIRE_QWEN35_4B_BASE=1
RUN_NAME=ht-debate-qwen35-real

# This is meaningfully larger than smoke:
# 2 task groups * 8 agents/group => 8 pairwise debates per step.
STEPS=5
NUM_GROUPS=2
GROUP_SIZE=8
ROLLOUT_BATCH_SIZE=0
SEQUENCE_LEN=8
MAX_TOKENS=128
SAMPLER_MAX_MODEL_LEN=2048
SAMPLER_GPU_MEMORY_UTILIZATION=0.55
TRAIN_MINIBATCH_SIZE=1

ADAPTER_LAYOUT=split
TEMPERATURE=0.7
MIN_P=0.0
SEED=0
REQUEST_SEED_MODE=none
LEARNING_RATE=1e-5
THINKING_MODE=no_think
ADVANTAGE_MODE=zscore
DEBATE_ROUNDS=3
DEBATE_R1_REWARD=task
DEBATE_R23_REWARD=constant
DEBATE_R23_CONSTANT=1.0
DEBATE_R23_MODE=symmetric
DEBATE_JUDGE_ADAPTER=policy
DEBATE_ROUND_ADAPTER_NAMES=solution debate debate
DEBATE_PROMPT_FORMAT=qwen35_base_text_prefill

TRACE_MODEL_IO=1
TRACE_TOP_LOGPROBS=5
RESOURCE_LOGGING=1
RESOURCE_LOG_INTERVAL_S=5
EXTRA_ARGS=
