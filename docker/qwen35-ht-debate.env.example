# Copy this file to docker/qwen35-ht-debate.env before running docker compose.
#
# Qwen/Qwen3.5-4B-Base is public at the time this file was written. If your
# Hugging Face setup requires auth, pass one of these through from your shell.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Model and run output.
MODEL_ID=Qwen/Qwen3.5-4B-Base
RUN_NAME=ht-debate-qwen35-smoke

# Conservative first-run settings for a shared 4070 machine.
STEPS=1
NUM_GROUPS=1
GROUP_SIZE=2
ROLLOUT_BATCH_SIZE=1
SEQUENCE_LEN=8
MAX_TOKENS=64
SAMPLER_MAX_MODEL_LEN=768
SAMPLER_GPU_MEMORY_UTILIZATION=0.45
TRAIN_MINIBATCH_SIZE=1

# Debate/training policy.
ADAPTER_LAYOUT=split
TEMPERATURE=0.7
MIN_P=0.0
SEED=0
LEARNING_RATE=1e-5
THINKING_MODE=no_think
ADVANTAGE_MODE=zscore
DEBATE_ROUNDS=3
DEBATE_R1_REWARD=task
DEBATE_R23_REWARD=constant
DEBATE_R23_CONSTANT=1.0
DEBATE_R23_MODE=symmetric
DEBATE_JUDGE_ADAPTER=policy
DEBATE_ROUND_ADAPTER_NAMES=solution debate debate

# Token-level trace logging.
TRACE_MODEL_IO=1
TRACE_TOP_LOGPROBS=5

# Optional extra flags appended to scripts/run_train.py.
EXTRA_ARGS=
